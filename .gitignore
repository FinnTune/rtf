# Ignore private key certificate (*.crt), private key (*.key) files, and certificate signing requests (*.csr) files.
# Ignore any file that ends with .pem???, .crt, .key, or .csr.
*.pem
*.crt
*.key
*.csr
node_modules/
database/forum.db
logfiles/*.log
uploads/
.VSCodeCounter/

# Playwright E2E suite (e2e/) — disposable test artifacts and the
# throwaway SQLite database/binary its setup script builds; see
# e2e/setup/run-server.sh.
e2e/.tmp/
e2e/.bin/
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
